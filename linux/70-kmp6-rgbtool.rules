# KM-P6 RGB Tool (Aukey KM-P6 RGB mouse pad): access for the logged-in user
# The lighting interface has no endpoint, so Linux creates no hidraw node for it and the tool uses usbfs
# (/dev/bus/usb/BBB/DDD); the hidraw line is kept for kernels that do create one.
# Install: sudo cp 70-kmp6-rgbtool.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
SUBSYSTEM=="usb", ATTR{idVendor}=="04d9", ATTR{idProduct}=="a1fa", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="04d9", ATTRS{idProduct}=="a1fa", MODE="0660", TAG+="uaccess"
